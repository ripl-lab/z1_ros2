<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>z1_task</name>
  <version>0.1.0</version>
  <description>MTC pick-and-place for the Z1 arm</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>control_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>

  <exec_depend>z1_moveit</exec_depend>
  <exec_depend>z1_bringup</exec_depend>
  <exec_depend>z1_examples</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
